{
  "$schema": "https://opencode.ai/config.json",
  "model": "huggingface/zai-org/GLM-5.3-Flash",
  "small_model": "huggingface/zai-org/GLM-5.3-Flash",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "pytest*": "allow",
      "python manage.py check*": "allow",
      "python manage.py test*": "allow",
      "python manage.py charger_parametres*": "allow",
      "rm -rf*": "deny"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}
